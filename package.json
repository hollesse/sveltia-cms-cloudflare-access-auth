{
  "name": "sveltia-cms-cloudflare-access-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker: E-Mail-Login via Cloudflare Access + GitHub-App-User-Token (Device-Flow) fuer Sveltia CMS, mit optionalem GitHub-Delegationsweg.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260904.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260903.1": true
  }
}
